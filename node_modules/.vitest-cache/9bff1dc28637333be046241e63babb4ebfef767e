,MAAM,CAAC,CAAC,MAAM,GAAG,MAAM,EAAE,KAAK,cAAc,EAAE,IAAI,CAAC,CAAC,CAAC,MAAM,GAAG,EAAE,CAAC,CAAC,KAAK,YAAY,iDAAC,YAAD;KAAsC;KAAe;IAAO,GAA3C,QAAQ;;;;WAAmC,CAAC,IAAI,iDAAC,YAAD;KAAY,OAAM;KAAsB,MAAK;IAA4C;;;;YAAW;;;;;;EAAM;;;;;;AAC7hG","names":[],"ignoreList":[],"sources":["AppPages.jsx"],"sourcesContent":["import { lazy, Suspense, useMemo, useState } from 'react';\nimport { Activity, ArrowDownRight, ArrowUpRight, Bell, Download, Edit3, Plus, ReceiptText, Search, Trash2, Users, X } from 'lucide-react';\nimport { Link, useNavigate, useParams } from 'react-router-dom';\nimport Avatar from '../components/Avatar';\nimport ExpenseForm from '../components/ExpenseForm';\nimport Modal from '../components/Modal';\nimport { calculateBalances, simplifyDebts } from '../utils/splitEngine';\nimport { formatMoney, fromPaise } from '../utils/money';\nimport { addGroupMember, filterAndSortExpenses, getExpenseAnalytics, getStoredReceiptBytes, removeGroup as removeGroupState } from '../utils/workspace';\n\nconst MonthlySpendChart = lazy(() => import('../components/AnalyticsCharts').then((module) => ({ default: module.MonthlySpendChart })));\nconst CategorySpendChart = lazy(() => import('../components/AnalyticsCharts').then((module) => ({ default: module.CategorySpendChart })));\n\nconst palette = ['#7162df', '#39a887', '#e5a34d', '#d97889', '#4e91c4', '#9b79bb', '#82a65a'];\nconst categories = ['Food', 'Travel', 'Rent', 'Shopping', 'Utilities', 'Entertainment', 'Education', 'Transportation', 'Other'];\nconst getMember = (data, id) => data.members?.find((person) => person.id === id) || { id, name: id === 'me' ? 'You' : 'Former member', initials: id === 'me' ? 'YO' : '?', color: '#8792a2' };\nconst expenseTotal = (expenses) => expenses.reduce((sum, expense) => sum + expense.amount, 0);\nconst createId = () => crypto.randomUUID();\nconst today = () => new Date().toISOString().slice(0, 10);\n\nfunction Metric({ label, amount, tone, icon: Icon, note }) {\n  return <article className={`metric ${tone}`}><div className=\"metric-top\"><span>{label}</span><i><Icon size={18} /></i></div><h2>{formatMoney(amount)}</h2><p>{note}</p></article>;\n}\nfunction EmptyState({ title, text, action }) { return <div className=\"empty-state\"><ReceiptText size={30} /><h3>{title}</h3><p>{text}</p>{action}</div>; }\nfunction monthSeries(expenses, count = 6) {\n  const now = new Date();\n  return Array.from({ length: count }, (_, index) => {\n    const date = new Date(now.getFullYear(), now.getMonth() - (count - 1 - index), 1);\n    const key = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`;\n    const amount = expenses.filter((expense) => expense.date?.startsWith(key)).reduce((sum, expense) => sum + expense.amount, 0);\n    return { month: date.toLocaleDateString('en-IN', { month: 'short' }), amount, key };\n  });\n}\nfunction downloadCsv(filename, rows) {\n  const csv = rows.map((row) => row.map((value) => `\"${String(value ?? '').replaceAll('\"', '\"\"')}\"`).join(',')).join('\\n');\n  const url = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));\n  const anchor = document.createElement('a'); anchor.href = url; anchor.download = filename; document.body.append(anchor); anchor.click(); anchor.remove(); setTimeout(() => URL.revokeObjectURL(url), 0);\n}\n\nfunction ExpenseRow({ expense, data, onEdit, onDelete }) {\n  const group = data.groups.find((item) => item.id === expense.groupId);\n  return <div className=\"expense-row\"><span className=\"expense-emoji\" aria-hidden=\"true\">{({ Food: '🍜', Travel: '✈️', Utilities: '💡', Shopping: '🛍️', Entertainment: '🎵', Rent: '🏡' })[expense.category] || '✦'}</span><div className=\"expense-title\"><b>{expense.description}{expense.generatedFrom === 'recurring' && <span className=\"source-badge\">Scheduled · generated</span>}</b><small>{group?.name || 'Deleted group'} · {expense.date} · {expense.category}{expense.receipt ? ' · Receipt attached' : ''}</small></div><div className=\"paid\"><small>{getMember(data, expense.paidBy).id === data.user.id ? 'You paid' : `${getMember(data, expense.paidBy).name.split(' ')[0]} paid`}</small><b>{formatMoney(expense.amount)}</b></div><div className=\"share\"><small>Your share</small><b>{formatMoney(expense.shares?.[data.user.id] || 0)}</b></div>{(onEdit || onDelete) && <div className=\"row-actions\">{onEdit && <button className=\"row-action\" aria-label={`Edit ${expense.description}`} title=\"Edit expense\" onClick={() => onEdit(expense)}><Edit3 size={15} /></button>}{onDelete && <button className=\"row-action\" aria-label={`Delete ${expense.description}`} title=\"Delete expense\" onClick={() => onDelete(expense)}><Trash2 size={15} /></button>}</div>}</div>;\n}\n\nexport function Dashboard({ data, addExpense }) {\n  const [showForm, setShowForm] = useState(false);\n  const expenses = data.expenses;\n  const analytics = getExpenseAnalytics(data);\n  const balances = analytics.balances;\n  const userId = data.user.id;\n  const owing = analytics.owing;\n  const owed = analytics.owed;\n  const trend = useMemo(() => monthSeries(expenses), [expenses]);\n  const byCategory = Object.entries(analytics.categorySpend).map(([name, value]) => ({ name, value }));\n  const recent = [...expenses].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);\n  const greeting = new Date().getHours() < 12 ? 'Good morning' : new Date().getHours() < 18 ? 'Good afternoon' : 'Good evening';\n  return <div className=\"page-content\">\n    <div className=\"page-intro\"><div><p className=\"eyebrow\">YOUR MONEY, IN CONTEXT</p><h2>{greeting}, {data.user.name.split(' ')[0]}</h2><p>A clear view of shared spending across your groups.</p></div><button className=\"button primary\" onClick={() => setShowForm(true)}><Plus size={17} />Add expense</button></div>\n    <section className=\"metrics\"><Metric label=\"NET BALANCE\" amount={balances[userId] || 0} tone={(balances[userId] || 0) >= 0 ? 'positive' : 'negative'} icon={(balances[userId] || 0) >= 0 ? ArrowUpRight : ArrowDownRight} note=\"Across all current groups\" /><Metric label=\"YOU OWE\" amount={owing} tone=\"warning\" icon={ArrowDownRight} note=\"Simplified outstanding debts\" /><Metric label=\"OWED TO YOU\" amount={owed} tone=\"positive\" icon={ArrowUpRight} note=\"Simplified outstanding debts\" /><Metric label=\"SPENT THIS MONTH\" amount={analytics.monthSpend} tone=\"neutral\" icon={ReceiptText} note={`${analytics.monthCount} recorded ${analytics.monthCount === 1 ? 'expense' : 'expenses'}`} /></section>\n    <section className=\"dashboard-grid\"><article className=\"panel chart-panel\"><header><div><p className=\"eyebrow\">ACTUAL GROUP EXPENSES</p><h3>Spend by month</h3></div><span className=\"chart-caption\">Last six calendar months</span></header>{trend.some((item) => item.amount > 0) ? <Suspense fallback={<p className=\"chart-loading\" role=\"status\">Loading chart…</p>}><MonthlySpendChart data={trend} /></Suspense> : <EmptyState title=\"No spending in this period\" text=\"Add a shared expense to see your monthly trend.\" />}</article>\n      <article className=\"panel category-panel\"><header><div><p className=\"eyebrow\">RECORDED CATEGORIES</p><h3>Where it went</h3></div></header>{byCategory.length ? <Suspense fallback={<p className=\"chart-loading\" role=\"status\">Loading chart…</p>}><CategorySpendChart data={byCategory} total={expenseTotal(expenses)} /></Suspense> : <EmptyState title=\"No categories yet\" text=\"Your expense categories will appear here.\" />}</article></section>\n    <section className=\"dashboard-grid lower-grid\"><article className=\"panel recent-panel\"><header><div><p className=\"eyebrow\">LATEST ACTIVITY</p><h3>Recent expenses</h3></div><Link className=\"plain-button\" to=\"/expenses\">All expenses →</Link></header>{recent.length ? recent.map((expense) => <ExpenseRow key={expense.id} expense={expense} data={data} />) : <EmptyState title=\"Nothing here yet\" text=\"Add your first shared expense to get started.\" />}</article><article className=\"panel group-overview\"><header><div><p className=\"eyebrow\">YOUR CIRCLES</p><h3>Group overview</h3></div><Link className=\"plain-button\" to=\"/groups\">View groups →</Link></header>{data.groups.length ? data.groups.slice(0, 4).map((group) => <Link className=\"overview-group\" key={group.id} to={`/groups/${group.id}`}><span className=\"group-emoji\">{group.emoji}</span><span><b>{group.name}</b><small>{group.members.length} members</small></span><strong>{formatMoney(expenseTotal(expenses.filter((expense) => expense.groupId === group.id)))}</strong></Link>) : <EmptyState title=\"Create a group\" text=\"Start a circle to track shared costs.\" />}</article></section>\n    {showForm && <Modal title=\"Add an expense\" onClose={() => setShowForm(false)}><ExpenseForm groups={data.groups} members={data.members || []} storedReceiptBytes={getStoredReceiptBytes(data.expenses)} onClose={() => setShowForm(false)} onSave={(expense) => { addExpense(expense); setShowForm(false); }} /></Modal>}\n  </div>;\n}\n\nexport function GroupsPage({ data, setData }) {\n  const navigate = useNavigate();\n  const [editing, setEditing] = useState(null);\n  const [error, setError] = useState('');\n  const saveGroup = (event) => {\n    event.preventDefault(); const form = new FormData(event.currentTarget);\n    const name = String(form.get('name')).trim(); const selected = form.getAll('members').map(String);\n    if (!name) { setError('Enter a group name.'); return; }\n    if (!selected.includes(data.user.id)) selected.push(data.user.id);\n    const group = { id: editing?.id || createId(), name, category: String(form.get('category')), emoji: editing?.emoji || '✦', members: selected };\n    setData((old) => ({ ...old, groups: editing?.id ? old.groups.map((item) => item.id === editing.id ? group : item) : [...old.groups, group], invitations: editing?.id ? (old.invitations || []) : [...(old.invitations || []), ...selected.filter((memberId) => memberId !== old.user.id).map((memberId) => ({ id: createId(), groupId: group.id, memberId, status: 'accepted', date: today() }))], notifications: editing?.id || old.settings?.notifications?.groupUpdates === false ? old.notifications : [{ id: createId(), title: 'Group created', text: `${group.name} is ready to use.`, read: false, date: today() }, ...old.notifications] }));\n    setEditing(null); setError('');\n  };\n  const removeGroup = (group) => {\n    if (!window.confirm(`Delete “${group.name}” and its expenses?`)) return;\n    setData((old) => removeGroupState(old, group.id));\n  };\n  return <div className=\"page-content\"><div className=\"page-intro\"><div><p className=\"eyebrow\">YOUR CIRCLES</p><h2>Groups that make plans happen.</h2><p>Manage members and shared history in one place.</p></div><button className=\"button primary\" onClick={() => setEditing({})}><Plus size={17} />Create group</button></div>\n    <div className=\"group-grid\">{data.groups.map((group) => { const total = expenseTotal(data.expenses.filter((expense) => expense.groupId === group.id)); return <article className=\"group-card-wrap\" key={group.id}><button className=\"group-card\" onClick={() => navigate(`/groups/${group.id}`)}><div className=\"group-card-head\"><span className=\"group-emoji\">{group.emoji}</span><span>{group.category}</span></div><h3>{group.name}</h3><div className=\"avatar-stack\">{group.members.slice(0, 5).map((id) => <Avatar key={id} member={getMember(data, id)} small />)}</div><footer><span>{group.members.length} members</span><b>{formatMoney(total)} <small>spent</small></b></footer></button><div className=\"group-card-actions\"><button className=\"button ghost small\" onClick={() => setEditing(group)}><Edit3 size={14} />Edit</button><button className=\"button ghost small\" onClick={() => removeGroup(group)}><Trash2 size={14} />Delete</button></div></article>; })}</div>\n    {!data.groups.length && <EmptyState title=\"No groups yet\" text=\"Create a group to start tracking shared spending.\" />}\n    {editing && <Modal title={editing.id ? 'Edit group' : 'Create a group'} onClose={() => { setEditing(null); setError(''); }}><form className=\"form-grid\" onSubmit={saveGroup}><label className=\"full\">Group name<input name=\"name\" required defaultValue={editing.name || ''} maxLength=\"60\" placeholder=\"e.g. Manali weekend\" /></label><label className=\"full\">Category<select name=\"category\" defaultValue={editing.category || 'Travel'}>{['Travel', 'Roommates', 'Friends', 'Family', 'College', 'Custom'].map((item) => <option key={item}>{item}</option>)}</select></label><fieldset className=\"participant-picker full\"><legend>Members (you are included)</legend><div className=\"participant-options\">{(data.members || []).map((person) => <label key={person.id}><input type=\"checkbox\" name=\"members\" value={person.id} defaultChecked={editing.members ? editing.members.includes(person.id) : person.id === data.user.id || person.id === 'maya'} />{person.name}</label>)}</div></fieldset>{error && <p className=\"form-error full\" role=\"alert\">{error}</p>}<div className=\"modal-actions full\"><button type=\"button\" className=\"button ghost\" onClick={() => setEditing(null)}>Cancel</button><button className=\"button primary\">{editing.id ? 'Save group' : 'Create group'}</button></div></form></Modal>}\n  </div>;\n}\n\nexport function GroupDetail({ data, setData, addExpense, updateExpense, onDelete }) {\n  const { id } = useParams(); const group = data.groups.find((item) => item.id === id);\n  const [expenseModal, setExpenseModal] = useState(false); const [editingExpense, setEditingExpense] = useState(null); const [inviteOpen, setInviteOpen] = useState(false);\n  if (!group) return <div className=\"page-content empty\"><h2>That group was not found.</h2><Link className=\"button primary\" to=\"/groups\">Back to groups</Link></div>;\n  const expenses = data.expenses.filter((expense) => expense.groupId === id).sort((a, b) => b.date.localeCompare(a.date));\n  const groupBalances = calculateBalances(expenses);\n  const candidates = (data.members || []).filter((person) => !group.members.includes(person.id));\n  const invite = (memberId) => {\n    if (!memberId) return;\n    setData((old) => addGroupMember(old, id, memberId, createId(), today()));\n    setInviteOpen(false);\n  };\n  const removeMember = (memberId) => {\n    if (memberId === data.user.id) return;\n    if (!window.confirm(`Remove ${getMember(data, memberId).name} from this group?`)) return;\n    setData((old) => ({ ...old, groups: old.groups.map((item) => item.id === id ? { ...item, members: item.members.filter((personId) => personId !== memberId) } : item) }));\n  };\n  const removeExpense = (expense) => { if (window.confirm(`Delete “${expense.description}”? This will recalculate balances.`)) onDelete(expense.id); };\n  const openExpense = (expense = null) => { setEditingExpense(expense); setExpenseModal(true); };\n  return <div className=\"page-content\"><Link className=\"back-link\" to=\"/groups\">← All groups</Link><section className=\"group-hero\"><span>{group.emoji}</span><div><p className=\"eyebrow\">{group.category}</p><h2>{group.name}</h2><div className=\"avatar-stack\">{group.members.map((memberId) => <Avatar key={memberId} member={getMember(data, memberId)} small />)}</div></div><button className=\"button soft\" onClick={() => setInviteOpen(true)}><Users size={16} />Add member</button></section>\n    <section className=\"summary-banner\"><div><small>GROUP SPENDING</small><b>{formatMoney(expenseTotal(expenses))}</b></div><div><small>YOUR SHARE</small><b>{formatMoney(expenses.reduce((sum, expense) => sum + (expense.shares[data.user.id] || 0), 0))}</b></div><div><small>MEMBERS</small><b>{group.members.length}</b></div></section>\n    <section className=\"two-col\"><article className=\"panel\"><header><div><p className=\"eyebrow\">PEOPLE & BALANCES</p><h3>Group members</h3></div><button className=\"button primary small\" onClick={() => setInviteOpen(true)}>Invite member</button></header>{group.members.map((memberId) => <div className=\"person-balance\" key={memberId}><Avatar member={getMember(data, memberId)} small /><span>{getMember(data, memberId).name}{memberId === data.user.id ? ' · You' : ''}</span><b className={(groupBalances[memberId] || 0) >= 0 ? 'green-text' : 'red-text'}>{(groupBalances[memberId] || 0) >= 0 ? '+' : ''}{formatMoney(groupBalances[memberId] || 0)}</b>{memberId !== data.user.id && <button className=\"row-action\" aria-label={`Remove ${getMember(data, memberId).name}`} onClick={() => removeMember(memberId)}><X size={16} /></button>}</div>)}</article><article className=\"panel\"><header><div><p className=\"eyebrow\">GROUP ACTIVITY</p><h3>Latest activity</h3></div></header>{expenses.slice(0, 4).map((expense) => <div className=\"activity-entry\" key={expense.id}><span><Activity size={15} /></span><p><b>{getMember(data, expense.paidBy).name}</b> added {expense.description}<small>{expense.date} · {formatMoney(expense.amount)}</small></p></div>)}{!expenses.length && <p className=\"panel-empty\">Expenses added to this group will appear here.</p>}</article></section>\n    <article className=\"panel recent-panel\"><header><div><p className=\"eyebrow\">GROUP LEDGER</p><h3>Expenses</h3></div><button className=\"button primary small\" onClick={() => openExpense()}><Plus size={15} />Add expense</button></header>{expenses.length ? expenses.map((expense) => <ExpenseRow key={expense.id} expense={expense} data={data} onEdit={openExpense} onDelete={removeExpense} />) : <EmptyState title=\"No expenses yet\" text=\"Add the first expense for this group.\" />}</article>\n    {inviteOpen && <Modal title={`Add someone to ${group.name}`} onClose={() => setInviteOpen(false)}><div className=\"invite-list\">{candidates.length ? candidates.map((person) => <div className=\"person-balance\" key={person.id}><Avatar member={person} small /><span>{person.name}</span><button className=\"button primary small\" onClick={() => invite(person.id)}>Add</button></div>) : <p className=\"panel-empty\">Everyone in the local demo directory is already a member.</p>}<p className=\"security-note\">Invitations are simulated locally and immediately added to this demo group.</p></div></Modal>}\n    {expenseModal && <Modal title={editingExpense ? 'Edit expense' : 'Add an expense'} onClose={() => setExpenseModal(false)}><ExpenseForm groups={[group]} members={data.members || []} initial={editingExpense} storedReceiptBytes={getStoredReceiptBytes(data.expenses, editingExpense?.id)} onClose={() => setExpenseModal(false)} onSave={(expense) => { (editingExpense ? updateExpense : addExpense)(expense); setExpenseModal(false); }} /></Modal>}\n  </div>;\n}\n\nexport function ExpensesPage({ data, addExpense, updateExpense, onDelete, runRecurring, updateRecurring, toggleRecurring, deleteRecurring }) {\n  const [query, setQuery] = useState(''); const [category, setCategory] = useState('All categories'); const [groupId, setGroupId] = useState('all'); const [sort, setSort] = useState('date-desc'); const [modal, setModal] = useState(false); const [selected, setSelected] = useState(null); const [selectedSchedule, setSelectedSchedule] = useState(null); const [forceRecurring, setForceRecurring] = useState(false);\n  const filtered = filterAndSortExpenses(data.expenses, { query, category, groupId, sort, memberName: (memberId) => getMember(data, memberId).name });\n  const remove = (expense) => { if (window.confirm(`Delete “${expense.description}”? This will recalculate balances.`)) onDelete(expense.id); };\n  const exportData = () => downloadCsv('splitspace-expenses.csv', [['Description', 'Group', 'Category', 'Paid by', 'Date', 'Amount INR', 'Your share INR', 'Source', 'Recurrence period', 'Receipt'], ...filtered.map((expense) => [expense.description, data.groups.find((group) => group.id === expense.groupId)?.name || '', expense.category, getMember(data, expense.paidBy).name, expense.date, fromPaise(expense.amount), fromPaise(expense.shares?.[data.user.id] || 0), expense.generatedFrom || 'manual', expense.recurrencePeriod || '', expense.receipt?.name || ''])]);\n  const openEdit = (expense) => { setSelected(expense); setModal(true); };\n  const openSchedule = (schedule = null) => { setSelected(null); setSelectedSchedule(schedule); setForceRecurring(true); setModal(true); };\n  const closeModal = () => { setModal(false); setSelected(null); setSelectedSchedule(null); setForceRecurring(false); };\n  const saveForm = (value) => {\n    if (value.schedule) updateRecurring(value.schedule);\n    else (selected ? updateExpense : addExpense)(value);\n    closeModal();\n  };\n  const removeSchedule = (schedule) => { if (window.confirm(`Remove the ${schedule.interval} schedule for “${schedule.description}”? Generated expenses will remain in the ledger.`)) deleteRecurring(schedule.id); };\n  return <div className=\"page-content\"><div className=\"page-intro\"><div><p className=\"eyebrow\">EVERY DETAIL</p><h2>Expense ledger</h2><p>Search, filter and manage shared records.</p></div><div className=\"page-actions\"><button className=\"button ghost\" onClick={() => openSchedule()}><span>Schedule expense</span></button><button className=\"button primary\" onClick={() => { setSelected(null); setSelectedSchedule(null); setForceRecurring(false); setModal(true); }}><Plus size={17} />Add expense</button></div></div>\n    <div className=\"list-toolbar\"><label className=\"search\"><Search size={18} /><span className=\"sr-only\">Search expenses</span><input value={query} onChange={(event) => setQuery(event.target.value)} placeholder=\"Search description, category, payer\" /></label><label><span className=\"sr-only\">Filter category</span><select value={category} onChange={(event) => setCategory(event.target.value)}><option>All categories</option>{categories.map((item) => <option key={item}>{item}</option>)}</select></label><label><span className=\"sr-only\">Filter group</span><select value={groupId} onChange={(event) => setGroupId(event.target.value)}><option value=\"all\">All groups</option>{data.groups.map((group) => <option key={group.id} value={group.id}>{group.name}</option>)}</select></label><label><span className=\"sr-only\">Sort expenses</span><select value={sort} onChange={(event) => setSort(event.target.value)}><option value=\"date-desc\">Newest first</option><option value=\"date-asc\">Oldest first</option><option value=\"amount-desc\">Highest amount</option><option value=\"amount-asc\">Lowest amount</option></select></label><button className=\"button ghost\" onClick={exportData}><Download size={16} />Export CSV</button></div>\n    <article className=\"panel expense-list\"><header><span>EXPENSE</span><span>PAID</span><span>YOUR SHARE</span><span>ACTIONS</span></header>{filtered.length ? filtered.map((expense) => <ExpenseRow key={expense.id} expense={expense} data={data} onEdit={openEdit} onDelete={remove} />) : <EmptyState title=\"No matching expenses\" text={data.expenses.length ? 'Adjust your search or filters.' : 'Add a shared expense to start your ledger.'} />}</article>\n    <section className=\"panel recurring-panel\"><header><div><p className=\"eyebrow\">SCHEDULED</p><h3>Recurring expenses</h3></div><button className=\"button ghost small\" onClick={runRecurring}>Check due schedules</button></header>{data.recurringExpenses?.length ? data.recurringExpenses.map((schedule) => <div className=\"recurring-row\" key={schedule.id}><div className=\"recurring-mark\" aria-hidden=\"true\">↻</div><div className=\"recurring-info\"><b>{schedule.description} <span className=\"source-badge\">Scheduled</span></b><small>{data.groups.find((group) => group.id === schedule.groupId)?.name || 'Deleted group'} · {schedule.interval} · starts {schedule.startDate}{schedule.endDate ? ` · ends ${schedule.endDate}` : ''}</small><small>Next due: {schedule.active ? schedule.nextDueDate : 'Paused'}</small></div><strong>{formatMoney(schedule.amount)}</strong><div className=\"row-actions\"><button className=\"row-action\" aria-label={`Edit schedule for ${schedule.description}`} title=\"Edit schedule\" onClick={() => openSchedule(schedule)}><Edit3 size={15} /></button><button className=\"button ghost small\" onClick={() => toggleRecurring(schedule.id, !schedule.active)}>{schedule.active ? 'Pause' : 'Resume'}</button><button className=\"row-action\" aria-label={`Remove schedule for ${schedule.description}`} title=\"Remove schedule\" onClick={() => removeSchedule(schedule)}><Trash2 size={15} /></button></div></div>) : <EmptyState title=\"No recurring schedules\" text=\"Create a schedule to automatically add future expenses when they become due.\" action={<button className=\"button ghost small\" onClick={() => openSchedule()}>Create schedule</button>} />}</section>\n    {modal && <Modal title={selectedSchedule ? 'Edit recurring schedule' : forceRecurring ? 'Schedule an expense' : selected ? 'Edit expense' : 'Add an expense'} onClose={closeModal}><ExpenseForm groups={data.groups} members={data.members || []} initial={selectedSchedule || selected} forceRecurring={forceRecurring || Boolean(selectedSchedule)} storedReceiptBytes={getStoredReceiptBytes(data.expenses, selected?.id)} onClose={closeModal} onSave={saveForm} /></Modal>}\n  </div>;\n}\n\nexport function BalancesPage({ data, settle }) {\n  const balances = calculateBalances(data.expenses, data.settlements);\n  const debts = simplifyDebts(balances);\n  const pending = data.settlements.filter((item) => item.status === 'pending');\n  return <div className=\"page-content\"><div className=\"page-intro\"><div><p className=\"eyebrow\">KEEP IT EVEN</p><h2>Balances, made simple.</h2><p>Suggested transfers are calculated from expenses and confirmed settlements.</p></div><Link className=\"button primary\" to=\"/settlements\">Settlement history</Link></div><section className=\"balance-hero\"><div><p>YOUR NET POSITION</p><h2 className={(balances[data.user.id] || 0) >= 0 ? 'green-text' : 'red-text'}>{formatMoney(balances[data.user.id] || 0)}</h2><span>{(balances[data.user.id] || 0) >= 0 ? 'You are owed overall' : 'You owe overall'}</span></div><div className=\"balance-orbit\"><span>₹</span></div></section><section className=\"two-col\"><article className=\"panel\"><header><div><p className=\"eyebrow\">SETTLE UP</p><h3>Suggested payments</h3></div></header>{debts.length ? debts.map((debt) => { const isPending = pending.some((item) => item.from === debt.from && item.to === debt.to); return <div className=\"debt-row\" key={`${debt.from}-${debt.to}`}><Avatar member={getMember(data, debt.from)} /><div><b>{getMember(data, debt.from).name}</b><small>owes {getMember(data, debt.to).name}</small></div><strong>{formatMoney(debt.amount)}</strong>{debt.from === data.user.id && <button className=\"button small primary\" disabled={isPending} onClick={() => settle(debt)}>{isPending ? 'Payment pending' : 'Record payment'}</button>}</div>; }) : <p className=\"panel-empty\">Everyone is settled up.</p>}</article><article className=\"panel\"><header><div><p className=\"eyebrow\">BY PERSON</p><h3>Individual balances</h3></div></header>{Object.entries(balances).map(([id, amount]) => <div className=\"person-balance\" key={id}><Avatar member={getMember(data, id)} small /><span>{getMember(data, id).name}</span><b className={amount >= 0 ? 'green-text' : 'red-text'}>{amount >= 0 ? '+' : ''}{formatMoney(amount)}</b></div>)}</article></section><p className=\"security-note\">Balances are local demo calculations. A pending payment changes balances only after confirmation.</p></div>;\n}\n\nexport function SettlementsPage({ data, confirmSettlement }) {\n  const pending = data.settlements.filter((item) => item.status === 'pending'); const history = data.settlements.filter((item) => item.status !== 'pending');\n  return <div className=\"page-content\"><div className=\"page-intro\"><div><p className=\"eyebrow\">PAYMENT LOG</p><h2>Settlement history</h2><p>Simulated payments only — no real transfer occurs.</p></div></div><article className=\"panel\"><header><div><p className=\"eyebrow\">ACTION REQUIRED</p><h3>Pending confirmations</h3></div></header>{pending.length ? pending.map((item) => <div className=\"settlement-row\" key={item.id}><span>{getMember(data, item.from).name} → {getMember(data, item.to).name}</span><b>{formatMoney(item.amount)}</b><span className=\"status pending\">Pending</span><button className=\"button primary small\" onClick={() => confirmSettlement(item.id)}>Confirm payment</button></div>) : <p className=\"panel-empty\">No pending payments.</p>}</article><article className=\"panel settlement-history\"><header><div><p className=\"eyebrow\">HISTORY</p><h3>Past settlement records</h3></div></header>{history.length ? history.map((item) => <div className=\"settlement-row\" key={item.id}><span>{getMember(data, item.from).name} → {getMember(data, item.to).name}</span><b>{formatMoney(item.amount)}</b><span>{item.confirmedAt || item.date}</span><span className={`status ${item.status}`}>{item.status}</span></div>) : <p className=\"panel-empty\">Confirmed payments will appear here.</p>}</article></div>;\n}\n\nexport function NotificationsPage({ data, setData }) {\n  const markRead = (id) => setData((old) => ({ ...old, notifications: old.notifications.map((item) => item.id === id ? { ...item, read: true } : item) }));\n  const allRead = () => setData((old) => ({ ...old, notifications: old.notifications.map((item) => ({ ...item, read: true })) }));\n  const remove = (id) => setData((old) => ({ ...old, notifications: old.notifications.filter((item) => item.id !== id) }));\n  return <div className=\"page-content narrow\"><div className=\"page-intro\"><div><p className=\"eyebrow\">STAY IN THE LOOP</p><h2>Your notifications</h2><p>{data.notifications.filter((item) => !item.read).length} unread</p></div><button className=\"button ghost\" disabled={!data.notifications.some((item) => !item.read)} onClick={allRead}>Mark all as read</button></div><article className=\"panel notifications\">{data.notifications.length ? data.notifications.map((note) => <div className={note.read ? 'notification' : 'notification unread'} key={note.id}><span className=\"notification-icon\"><Bell size={18} /></span><div><b>{note.title}</b><p>{note.text}</p><small>{note.date || 'Earlier'}</small></div><div className=\"row-actions\">{!note.read && <button className=\"button ghost small\" onClick={() => markRead(note.id)}>Mark read</button>}<button aria-label={`Delete notification: ${note.title}`} className=\"icon-button\" onClick={() => remove(note.id)}><Trash2 size={16} /></button></div></div>) : <EmptyState title=\"You're all caught up\" text=\"New group and expense updates will appear here.\" />}</article></div>;\n}\n\nexport function ActivityPage({ data }) {\n  const entries = [...data.expenses.map((expense) => ({ id: expense.id, date: expense.date, text: `${getMember(data, expense.paidBy).name} added ${expense.description}`, detail: `${data.groups.find((group) => group.id === expense.groupId)?.name || 'Group'} · ${formatMoney(expense.amount)}` })), ...data.settlements.map((item) => ({ id: `settlement-${item.id}`, date: item.confirmedAt || item.date, text: `${getMember(data, item.from).name} → ${getMember(data, item.to).name} settlement ${item.status}`, detail: formatMoney(item.amount) }))].sort((a, b) => b.date.localeCompare(a.date));\n  return <div className=\"page-content narrow\"><div className=\"page-intro\"><div><p className=\"eyebrow\">THE PAPER TRAIL</p><h2>Activity history</h2></div></div><article className=\"panel activity-list\">{entries.length ? entries.map((entry) => <div key={entry.id}><span><Activity size={17} /></span><p>{entry.text}<small>{entry.detail} · {entry.date}</small></p></div>) : <EmptyState title=\"No activity yet\" text=\"Your shared activity will show here.\" />}</article></div>;\n}\n\nexport function SettingsPage({ data, theme, setTheme, setData, reset, logout, saveProfile }) {\n  const navigate = useNavigate();\n  const [editingProfile, setEditingProfile] = useState(false);\n  const preferences = data.settings?.notifications || { expenseUpdates: true, groupUpdates: true, settlementUpdates: true };\n  const updatePreference = (key, checked) => setData((old) => ({ ...old, settings: { ...old.settings, notifications: { ...old.settings?.notifications, [key]: checked } } }));\n  const profileSubmit = (event) => { event.preventDefault(); const form = new FormData(event.currentTarget); saveProfile({ ...data.user, name: String(form.get('name')).trim(), email: String(form.get('email')).trim() }); setEditingProfile(false); };\n  return <div className=\"page-content narrow\"><div className=\"page-intro\"><div><p className=\"eyebrow\">YOUR PREFERENCES</p><h2>Settings</h2><p>Customize this local demo workspace.</p></div></div><article className=\"panel settings\"><h3>Profile</h3><div><div><b>{data.user.name}</b><p>{data.user.email || 'Demo profile stored on this device'}</p></div><button className=\"button ghost small\" onClick={() => setEditingProfile(true)}>Edit profile</button></div><h3>Appearance</h3><div><div><b>Color theme</b><p>Choose a light or dark workspace.</p></div><div className=\"segmented\"><button onClick={() => setTheme('light')} className={theme === 'light' ? 'selected' : ''} aria-pressed={theme === 'light'}>Light</button><button onClick={() => setTheme('dark')} className={theme === 'dark' ? 'selected' : ''} aria-pressed={theme === 'dark'}>Dark</button></div></div><h3>Notifications</h3>{[['expenseUpdates', 'Expense updates'], ['groupUpdates', 'Group updates'], ['settlementUpdates', 'Settlement updates']].map(([key, label]) => <div key={key}><div><b>{label}</b><p>Show local notifications for {label.toLowerCase()}.</p></div><input type=\"checkbox\" checked={preferences[key] !== false} onChange={(event) => updatePreference(key, event.target.checked)} aria-label={label} /></div>)}<h3>Demo data</h3><div><div><b>Reset workspace</b><p>Restore bundled sample groups and expenses.</p></div><button className=\"button danger small\" onClick={reset}>Reset demo data</button></div><h3>Session</h3><div><div><b>Sign out</b><p>Clear this simulated local session.</p></div><button className=\"button ghost small\" onClick={() => { logout(); navigate('/login'); }}>Log out</button></div></article><p className=\"security-note\">Authentication and saved profile details are frontend-only simulations, not production security.</p>\n    {editingProfile && <Modal title=\"Edit profile\" onClose={() => setEditingProfile(false)}><form className=\"form-grid\" onSubmit={profileSubmit}><label className=\"full\">Name<input required name=\"name\" defaultValue={data.user.name} maxLength=\"60\" /></label><label className=\"full\">Email<input required name=\"email\" type=\"email\" defaultValue={data.user.email || 'aarav@splitspace.demo'} /></label><div className=\"modal-actions full\"><button type=\"button\" className=\"button ghost\" onClick={() => setEditingProfile(false)}>Cancel</button><button className=\"button primary\">Save profile</button></div></form></Modal>}\n  </div>;\n}\n\nexport function AdminPage({ data }) {\n  const analytics = getExpenseAnalytics(data); const total = analytics.totalSpend; const categoriesSpend = Object.entries(analytics.categorySpend).map(([name, value]) => ({ name, value }));\n  const groupSpend = data.groups.map((group) => ({ name: group.name, amount: expenseTotal(data.expenses.filter((expense) => expense.groupId === group.id)) }));\n  const trend = monthSeries(data.expenses, 6); const pending = data.settlements.filter((item) => item.status === 'pending');\n  const exportReport = () => downloadCsv('splitspace-admin-report.csv', [['Group', 'Expenses count', 'Spend INR', 'Members'], ...data.groups.map((group) => { const expenses = data.expenses.filter((expense) => expense.groupId === group.id); return [group.name, expenses.length, fromPaise(expenseTotal(expenses)), group.members.length]; }), [], ['Settlement status', 'From', 'To', 'Amount INR'], ...data.settlements.map((item) => [item.status, getMember(data, item.from).name, getMember(data, item.to).name, fromPaise(item.amount)])]);\n  return <div className=\"page-content\"><div className=\"admin-notice\">LOCAL ADMIN VIEW · Demo records only. This is not an authorization boundary.</div><div className=\"page-intro\"><div><p className=\"eyebrow\">WORKSPACE ANALYTICS</p><h2>Recorded activity</h2><p>Metrics are calculated from the data stored in this browser.</p></div><button className=\"button ghost\" onClick={exportReport}><Download size={16} />Export report</button></div><section className=\"metrics\"><Metric label=\"LOCAL MEMBERS\" amount={data.members?.length || 0} tone=\"neutral\" icon={Users} note=\"Member directory records\" /><Metric label=\"ACTIVE GROUPS\" amount={data.groups.length} tone=\"positive\" icon={Users} note=\"Groups in this workspace\" /><Metric label=\"RECORDED SPEND\" amount={total} tone=\"warning\" icon={ReceiptText} note={`${data.expenses.length} expenses`} /><Metric label=\"PENDING SETTLEMENTS\" amount={expenseTotal(pending)} tone=\"negative\" icon={Activity} note={`${pending.length} awaiting confirmation`} /></section><section className=\"dashboard-grid\"><article className=\"panel chart-panel\"><header><div><p className=\"eyebrow\">RECORDED SPEND</p><h3>Monthly expense volume</h3></div></header>{trend.some((item) => item.amount) ? <Suspense fallback={<p className=\"chart-loading\" role=\"status\">Loading chart…</p>}><MonthlySpendChart data={trend} label=\"Monthly spend\" /></Suspense> : <EmptyState title=\"No expense history\" text=\"Recorded spending will appear as expenses are added.\" />}</article><article className=\"panel\"><header><div><p className=\"eyebrow\">BY GROUP</p><h3>Group spend</h3></div></header>{groupSpend.length ? groupSpend.map((item) => <div className=\"person-balance\" key={item.name}><span>{item.name}</span><b>{formatMoney(item.amount)}</b></div>) : <p className=\"panel-empty\">No groups yet.</p>}</article></section><section className=\"dashboard-grid\"><article className=\"panel\"><header><div><p className=\"eyebrow\">CATEGORIES</p><h3>Spend distribution</h3></div></header>{categoriesSpend.length ? categoriesSpend.map((item, index) => <div className=\"person-balance\" key={item.name}><i className=\"color-dot\" style={{ background: palette[index % palette.length] }} /><span>{item.name}</span><b>{formatMoney(item.value)}</b></div>) : <p className=\"panel-empty\">No categorized expenses yet.</p>}</article><article className=\"panel\"><header><div><p className=\"eyebrow\">MEMBER DIRECTORY</p><h3>Workspace members</h3></div></header>{(data.members || []).map((person) => <div className=\"person-balance\" key={person.id}><Avatar member={person} small /><span>{person.name}</span><small>{data.groups.filter((group) => group.members.includes(person.id)).length} groups</small></div>)}</article></section><article className=\"panel\"><header><div><p className=\"eyebrow\">TRANSACTION REPORT</p><h3>Recent records</h3></div></header>{data.expenses.length ? data.expenses.slice().sort((a, b) => b.date.localeCompare(a.date)).slice(0, 10).map((expense) => <ExpenseRow key={expense.id} expense={expense} data={data} />) : <EmptyState title=\"No transactions yet\" text=\"New expenses will appear in this report.\" />}</article></div>;\n}\n"],"file":"/src/pages/AppPages.jsx"}