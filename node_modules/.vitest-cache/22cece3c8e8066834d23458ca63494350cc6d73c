AAC,oDAAC,8BAAD;GAAO,MAAK;GAAiB,SAAS,MAAM,oDAAC,0CAAD;IAAyB;IAAe;GAAS;;;;WAAC;EAAG;;;;;EAAC,oDAAC,8BAAD;GAAO,MAAK;GAAY,SAAS,MAAM,oDAAC,qCAAD;IAAoB;IAAe;IAAgB;IAAO,UAAU;IAAsB;IAAe;IAAqB;GAAa;;;;WAAC;EAAG;;;;;EAAC,oDAAC,8BAAD;GAAO,MAAK;GAAS,SAAS,MAAM,oDAAC,kCAAD,EAAiB,KAAM;;;;WAAC;EAAG;;;;;EAAC,oDAAC,8BAAD;GAAO,MAAK;GAAI,SAAS,oDAAC,iCAAD;IAAU,IAAG;IAAI;GAAQ;;;;;EAAG;;;;;CACxwC;;;;;AACV","names":[],"ignoreList":[],"sources":["App.jsx"],"sourcesContent":["import { useEffect, useState } from 'react';\nimport { Navigate, Route, Routes } from 'react-router-dom';\nimport AppShell from './components/AppShell';\nimport { getData, getTheme, resetData, saveData, saveTheme } from './services/store';\nimport { confirmSettlement as confirmSettlementState, processDueRecurring, removeExpense as removeExpenseState, removeRecurringSchedule, setRecurringScheduleActive, upsertExpense, upsertRecurringSchedule } from './utils/workspace';\nimport { Landing, InfoPage } from './pages/PublicPages';\nimport AuthPage from './pages/AuthPage';\nimport { ActivityPage, AdminPage, BalancesPage, Dashboard, ExpensesPage, GroupDetail, GroupsPage, NotificationsPage, SettlementsPage, SettingsPage } from './pages/AppPages';\n\nexport default function App() {\n  const [data, setData] = useState(() => processDueRecurring(getData(), new Date().toISOString().slice(0, 10), () => crypto.randomUUID())); const [theme, setThemeState] = useState(getTheme);\n  const [authenticated, setAuthenticated] = useState(() => { try { return Boolean(localStorage.getItem('splitspace-session')); } catch { return false; } });\n  useEffect(() => { saveData(data); }, [data]); useEffect(() => { document.documentElement.dataset.theme = theme; saveTheme(theme); }, [theme]);\n  const notify = (old, title, text, preference) => old.settings?.notifications?.[preference] === false ? old.notifications : [{ id: crypto.randomUUID(), title, text, read: false, date: new Date().toISOString().slice(0, 10) }, ...old.notifications];\n  const addExpense = (expense) => setData((old) => {\n    if (expense.schedule) return processDueRecurring(upsertRecurringSchedule(old, expense.schedule), new Date().toISOString().slice(0, 10), () => crypto.randomUUID());\n    return { ...upsertExpense(old, expense), notifications: notify(old, 'Expense added', `${expense.description} was added to your activity.`, 'expenseUpdates') };\n  });\n  const updateExpense = (expense) => setData((old) => upsertExpense(old, expense));\n  const deleteExpense = (id) => setData((old) => removeExpenseState(old, id));\n  const settle = (debt) => setData((old) => ({ ...old, settlements: [{ id: crypto.randomUUID(), from: debt.from, to: debt.to, amount: debt.amount, status: 'pending', date: new Date().toISOString().slice(0, 10) }, ...old.settlements] }));\n  const confirmSettlement = (id) => setData((old) => confirmSettlementState(old, id, { nextId: crypto.randomUUID(), date: new Date().toISOString().slice(0, 10) }));\n  const runRecurring = () => setData((old) => processDueRecurring(old, new Date().toISOString().slice(0, 10), () => crypto.randomUUID()));\n  const updateRecurring = (schedule) => setData((old) => processDueRecurring(upsertRecurringSchedule(old, schedule), new Date().toISOString().slice(0, 10), () => crypto.randomUUID()));\n  const toggleRecurring = (id, active) => setData((old) => {\n    const updated = setRecurringScheduleActive(old, id, active);\n    return active ? processDueRecurring(updated, new Date().toISOString().slice(0, 10), () => crypto.randomUUID()) : updated;\n  });\n  const deleteRecurring = (id) => setData((old) => removeRecurringSchedule(old, id));\n  const saveProfile = (user) => {\n    const initials = user.name.trim().split(/\\s+/).slice(0, 2).map((part) => part[0]?.toUpperCase() || '').join('');\n    const updatedUser = { ...user, initials };\n    setData((old) => ({ ...old, user: updatedUser, members: (old.members || []).map((member) => member.id === user.id ? { ...member, ...updatedUser } : member) }));\n  };\n  const logout = () => { try { localStorage.removeItem('splitspace-session'); } catch { /* Session is local-only. */ } setAuthenticated(false); };\n  const authenticate = (profile) => {\n    try { localStorage.setItem('splitspace-session', profile.email || 'demo'); } catch { /* The demo remains usable in memory. */ }\n    setAuthenticated(true);\n    if (profile.name || profile.email) saveProfile({ ...data.user, name: profile.name || data.user.name, email: profile.email || data.user.email });\n  };\n  const reset = () => { if (window.confirm('Reset all local Splitspace demo data?')) setData(resetData()); };\n  const unread = data.notifications.filter((note) => !note.read).length;\n  const shell = (content) => authenticated ? <AppShell data={data} unread={unread} theme={theme} setTheme={setThemeState}>{content}</AppShell> : <Navigate to=\"/login\" replace />;\n  return <Routes>\n     <Route path=\"/\" element={<Landing/>}/><Route path=\"/features\" element={<InfoPage type=\"features\"/>}/><Route path=\"/about\" element={<InfoPage type=\"about\"/>}/><Route path=\"/login\" element={<AuthPage mode=\"login\" onAuthenticate={authenticate}/>}/><Route path=\"/register\" element={<AuthPage mode=\"register\" onAuthenticate={authenticate}/>}/>\n       <Route path=\"/dashboard\" element={shell(<Dashboard data={data} addExpense={addExpense}/>)}/><Route path=\"/groups\" element={shell(<GroupsPage data={data} setData={setData}/>)}/><Route path=\"/groups/:id\" element={shell(<GroupDetail data={data} setData={setData} addExpense={addExpense} updateExpense={updateExpense} onDelete={deleteExpense}/>)}/><Route path=\"/expenses\" element={shell(<ExpensesPage data={data} addExpense={addExpense} updateExpense={updateExpense} onDelete={deleteExpense} runRecurring={runRecurring} updateRecurring={updateRecurring} toggleRecurring={toggleRecurring} deleteRecurring={deleteRecurring}/>)}/><Route path=\"/balances\" element={shell(<BalancesPage data={data} settle={settle}/>)}/><Route path=\"/settlements\" element={shell(<SettlementsPage data={data} confirmSettlement={confirmSettlement}/>)}/><Route path=\"/activity\" element={shell(<ActivityPage data={data}/>)}/><Route path=\"/notifications\" element={shell(<NotificationsPage data={data} setData={setData}/>)}/><Route path=\"/settings\" element={shell(<SettingsPage data={data} setData={setData} theme={theme} setTheme={setThemeState} reset={reset} logout={logout} saveProfile={saveProfile}/>)}/><Route path=\"/admin\" element={shell(<AdminPage data={data}/>)}/><Route path=\"*\" element={<Navigate to=\"/\" replace/>}/>\n  </Routes>;\n}\n"],"file":"/src/App.jsx"}