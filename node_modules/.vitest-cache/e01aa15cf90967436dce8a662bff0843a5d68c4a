in' : 'Settings');\n  const closeNav = () => setOpen(false);\n  return <div className=\"app-shell\"><aside className={open ? 'sidebar open' : 'sidebar'}><Link className=\"brand\" to=\"/dashboard\" onClick={closeNav}><span className=\"brand-mark\">S</span><span>SPLITSPACE</span></Link><nav aria-label=\"Main navigation\">{primary.map(({ to, label, icon: Icon }) => <NavLink onClick={closeNav} key={to} to={to}><Icon size={18} />{label}</NavLink>)}</nav><div className=\"sidebar-bottom\"><NavLink onClick={closeNav} to=\"/notifications\"><Bell size={18} />Notifications{unread > 0 && <span className=\"nav-count\">{unread}</span>}</NavLink><NavLink onClick={closeNav} to=\"/admin\"><ShieldCheck size={18} />Admin demo</NavLink><NavLink onClick={closeNav} to=\"/settings\"><Settings size={18} />Settings</NavLink><Link to=\"/about\" onClick={closeNav}><CircleHelp size={18} />About Splitspace</Link><div className=\"upgrade\"><p>Shared spending, clearly settled.</p><Link className=\"button small primary\" to=\"/groups\" onClick={closeNav}>Manage groups</Link></div></div></aside>{open && <button className=\"sidebar-scrim\" aria-label=\"Close navigation\" onClick={closeNav} />}<main><header className=\"topbar\"><button aria-label={open ? 'Close navigation menu' : 'Open navigation menu'} aria-expanded={open} className=\"icon-button mobile-menu\" onClick={() => setOpen(!open)}>{open ? <X /> : <Menu />}</button><div><p className=\"eyebrow\">WORKSPACE / {title}</p><h1>{title}</h1></div><div className=\"topbar-actions\"><button aria-label={`Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`} className=\"icon-button theme-toggle\" onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}>{theme === 'dark' ? <Sun size={18} /> : <Moon size={18} />}</button><Link className=\"icon-button notification-button\" aria-label={`Notifications${unread ? `, ${unread} unread` : ''}`} to=\"/notifications\"><Bell size={19} />{unread > 0 && <i>{unread}</i>}</Link><Link className=\"profile-button\" to=\"/settings\" aria-label={`Profile and settings for ${data.user.name}`}><Avatar member={data.user} small /><span>{data.user.name.split(' ')[0]}</span></Link></div></header>{storageWarning && <div className=\"storage-warning\" role=\"alert\">{storageWarning}</div>}{children}</main></div>;\n}\n"],"file":"/src/components/AppShell.jsx"}