: 'me', method: 'equal', date: new Date().toISOString().slice(0, 10),\n  });\n  const group = groups.find((item) => item.id === form.groupId);\n  const groupIds = group?.members || [];\n  const [participants, setParticipants] = useState(() => initial ? Object.keys(initial.shares) : groupIds);\n  const [allocations, setAllocations] = useState(() => initial ? Object.fromEntries(Object.entries(initial.shares).map(([id, amount]) => [id, form.method === 'custom' ? fromPaise(amount) : ''])) : {});\n  const [isRecurring, setIsRecurring] = useState(forceRecurring || Boolean(initial?.interval));\n  const [interval, setInterval] = useState(initial?.interval || 'monthly');\n  const [endDate, setEndDate] = useState(initial?.endDate || '');\n  const [receipt, setReceipt] = useState(initial?.receipt || null);\n  const [receiptLoading, setReceiptLoading] = useState(false);\n  const [error, setError] = useState('');\n  const people = members.filter((person) => groupIds.includes(person.id));\n\n  const set = (key, value) => setForm((current) => ({ ...current, [key]: value }));\n  const toggleParticipant = (id) => setParticipants((current) => current.includes(id) ? current.filter((item) => item !== id) : [...current, id]);\n  const selectReceipt = async (event) => {\n    const file = event.target.files?.[0];\n    event.target.value = '';\n    if (!file) return;\n    try {\n      validateReceiptFile(file, storedReceiptBytes, receipt?.size || 0);\n      setReceiptLoading(true); setError('');\n      setReceipt(await readReceiptDataUrl(file));\n    } catch (exception) { setError(exception.message || 'The receipt could not be added.'); }\n    finally { setReceiptLoading(false); }\n  };\n  const submit = (event) => {\n    event.preventDefault();\n    try {\n      if (!form.description.trim()) throw new Error('Add a description for this expense.');\n      if (!form.date) throw new Error('Choose the date of this expense.');\n      const amount = toPaise(form.amount);\n      const splitInput = Object.fromEntries(participants.map((id) => [id, allocations[id] ?? '']));\n      const shares = form.method === 'equal' ? equalSplit(amount, participants)\n        : form.method === 'percentage' ? percentageSplit(amount, splitInput) : customSplit(amount, splitInput);\n      if (!groupIds.includes(form.paidBy)) throw new Error('Select a payer from the group.');\n      if (isRecurring) {\n        const [, month, day] = form.date.split('-').map(Number);\n        validateRecurrence({ interval, startDate: form.date, endDate: endDate || null, amount, shares, memberIds: groupIds });\n        const sameStart = initial?.interval && initial.startDate === form.date;\n        onSave({ schedule: {\n          id: initial?.interval ? initial.id : crypto.randomUUID(), description: form.description.trim(), amount,\n          groupId: form.groupId, category: form.category, paidBy: form.paidBy, shares, method: form.method,\n          interval, startDate: form.date, endDate: endDate || null,\n          nextDueDate: sameStart ? initial.nextDueDate : form.date,\n          active: initial?.interval ? initial.active !== false : true,\n          anchorDay: day, anchorMonth: month, createdAt: initial?.createdAt || new Date().toISOString(),\n        } });\n      } else {\n        const expenseForm = { ...form };\n        delete expenseForm.receipt;\n        onSave({ ...expenseForm, description: form.description.trim(), amount, shares, id: initial?.id || crypto.randomUUID(), date: form.date, ...(receipt ? { receipt } : {}) });\n      }\n      setError('');\n    } catch (exception) { setError(exception.message || 'Check the expense details and try again.'); }\n  };\n\n  return <form className=\"form-grid\" onSubmit={submit} noValidate>\n    <label className=\"full\">Description<input required maxLength=\"80\" value={form.description} onChange={(event) => set('description', event.target.value)} placeholder=\"e.g. Sunday brunch\" /></label>\n    <label>Amount (₹)<input required min=\"0.01\" step=\"0.01\" type=\"number\" value={form.amount} onChange={(event) => set('amount', event.target.value)} placeholder=\"0.00\" /></label>\n    <label>Date<input required type=\"date\" value={form.date} onChange={(event) => set('date', event.target.value)} /></label>\n    <label>Group<select required value={form.groupId} onChange={(event) => { const nextGroup = groups.find((item) => item.id === event.target.value); setForm((current) => ({ ...current, groupId: event.target.value, paidBy: nextGroup?.members.includes(current.paidBy) ? current.paidBy : nextGroup?.members[0] || '' })); setParticipants(nextGroup?.members || []); setAllocations({}); }}>{groups.map((item) => <option key={item.id} value={item.id}>{item.name}</option>)}</select></label>\n    <label>Category<select value={form.category} onChange={(event) => set('category', event.target.value)}>{categories.map((category) => <option key={category}>{category}</option>)}</select></label>\n    <label className=\"full\">Paid by<select required value={form.paidBy} onChange={(event) => set('paidBy', event.target.value)}>{people.map((person) => <option key={person.id} value={person.id}>{person.name}</option>)}</select></label>\n    {forceRecurring || initial?.interval ? <p className=\"recurrence-hint full\">This form edits a recurring schedule. Generated expenses are recorded separately on each due date.</p> : <label className=\"recurring-toggle full\"><input type=\"checkbox\" checked={isRecurring} onChange={(event) => setIsRecurring(event.target.checked)} />Repeat this expense on a schedule</label>}\n    {isRecurring && <><label>Repeats<select value={interval} onChange={(event) => setInterval(event.target.value)}>{['daily', 'weekly', 'monthly', 'yearly'].map((value) => <option key={value} value={value}>{value[0].toUpperCase() + value.slice(1)}</option>)}</select></label><label>End date (optional)<input type=\"date\" min={form.date} value={endDate} onChange={(event) => setEndDate(event.target.value)} /></label><p className=\"recurrence-hint full\">First due {form.date}. The schedule advances after each generated occurrence.</p></>}\n    <fieldset className=\"split-method full\"><legend>Split method</legend>{['equal', 'percentage', 'custom'].map((method) => <label key={method} className=\"radio\"><input checked={form.method === method} onChange={() => set('method', method)} type=\"radio\" name=\"split-method\" />{method[0].toUpperCase() + method.slice(1)}</label>)}</fieldset>\n    <fieldset className=\"participant-picker full\"><legend>Participants</legend><div className=\"participant-options\">{people.map((person) => <label key={person.id}><input type=\"checkbox\" checked={participants.includes(person.id)} onChange={() => toggleParticipant(person.id)} />{person.name}</label>)}</div></fieldset>\n    {form.method !== 'equal' && <div className=\"allocation full\"><p className=\"field-label\">{form.method === 'percentage' ? 'Shares (must total 100%)' : 'Amounts (must equal the total)'}</p>{people.filter((person) => participants.includes(person.id)).map((person) => <label key={person.id} className=\"allocation-row\"><span>{person.name}</span><input required type=\"number\" min=\"0\" step={form.method === 'percentage' ? '0.01' : '0.01'} value={allocations[person.id] ?? ''} onChange={(event) => setAllocations((current) => ({ ...current, [person.id]: event.target.value }))} placeholder={form.method === 'percentage' ? '%' : '₹'} /></label>)}</div>}\n    {!isRecurring && <section className=\"receipt-field full\" aria-label=\"Expense receipt\"><div><b>Receipt</b><p>Optional local image or PDF · max 1 MB per file</p></div>{receipt ? <div className=\"receipt-preview\">{receipt.type === 'application/pdf' ? <object data={receipt.dataUrl} type=\"application/pdf\" aria-label=\"Receipt PDF preview\"><p>PDF preview is unavailable. <a href={receipt.dataUrl} download={receipt.name}>Download {receipt.name}</a></p></object> : <img src={receipt.dataUrl} alt={`Receipt for ${form.description || 'this expense'}`} />}<div className=\"receipt-actions\"><span>{receipt.name}</span><label className=\"button ghost small\">Replace<input className=\"file-input-hidden\" type=\"file\" accept=\"image/jpeg,image/png,image/webp,image/gif,application/pdf\" onChange={selectReceipt} /></label><button type=\"button\" className=\"button ghost small\" onClick={() => setReceipt(null)}>Remove</button></div></div> : <label className=\"button ghost small receipt-picker\">Choose receipt<input className=\"file-input-hidden\" type=\"file\" accept=\"image/jpeg,image/png,image/webp,image/gif,application/pdf\" onChange={selectReceipt} /></label>}{receiptLoading && <p className=\"form-status\" role=\"status\">Reading receipt…</p>}</section>}\n    {error && <p className=\"form-error full\" role=\"alert\">{error}</p>}\n    <div className=\"modal-actions full\"><button type=\"button\" className=\"button ghost\" onClick={onClose}>Cancel</button><button className=\"button primary\" type=\"submit\" disabled={receiptLoading}>{isRecurring ? (initial?.interval ? 'Save schedule' : 'Create schedule') : (initial ? 'Save changes' : 'Add expense')}</button></div>\n  </form>;\n}\n"],"file":"/src/components/ExpenseForm.jsx"}