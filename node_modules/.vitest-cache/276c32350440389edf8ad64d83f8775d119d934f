AChoB,SAAS,iDAAC,KAAD;IAAG,WAAU;IAAkB,MAAK;cAAS;GAAS;;;;;GAChE,iDAAC,OAAD;IAAK,WAAU;cAAf,CAAoC,iDAAC,UAAD;KAAQ,MAAK;KAAS,WAAU;KAAe,SAAS;eAAS;IAAc;;;;cAAC,iDAAC,UAAD;KAAQ,WAAU;KAAiB,MAAK;eAAU,UAAU,iBAAiB;IAAsB;;;;YAAM;;;;;;EACzN;;;;;;AACR","names":[],"ignoreList":[],"sources":["ExpenseForm.jsx"],"sourcesContent":["import { useState } from 'react';\nimport { customSplit, equalSplit, percentageSplit } from '../utils/splitEngine';\nimport { fromPaise, toPaise } from '../utils/money';\n\nconst categories = ['Food', 'Travel', 'Rent', 'Shopping', 'Utilities', 'Entertainment', 'Education', 'Transportation', 'Other'];\n\nexport default function ExpenseForm({ groups, members, initial, onSave, onClose }) {\n  const [form, setForm] = useState(() => initial ? { ...initial, amount: fromPaise(initial.amount), method: initial.method || 'custom' } : {\n    description: '', amount: '', groupId: groups[0]?.id || '', category: 'Food', paidBy: 'me', method: 'equal', date: new Date().toISOString().slice(0, 10),\n  });\n  const group = groups.find((item) => item.id === form.groupId);\n  const groupIds = group?.members || [];\n  const [participants, setParticipants] = useState(() => initial ? Object.keys(initial.shares) : groupIds);\n  const [allocations, setAllocations] = useState(() => initial ? Object.fromEntries(Object.entries(initial.shares).map(([id, amount]) => [id, form.method === 'custom' ? fromPaise(amount) : ''])) : {});\n  const [error, setError] = useState('');\n  const people = members.filter((person) => groupIds.includes(person.id));\n\n  const set = (key, value) => setForm((current) => ({ ...current, [key]: value }));\n  const toggleParticipant = (id) => setParticipants((current) => current.includes(id) ? current.filter((item) => item !== id) : [...current, id]);\n  const submit = (event) => {\n    event.preventDefault();\n    try {\n      if (!form.description.trim()) throw new Error('Add a description for this expense.');\n      if (!form.date) throw new Error('Choose the date of this expense.');\n      const amount = toPaise(form.amount);\n      const splitInput = Object.fromEntries(participants.map((id) => [id, allocations[id] ?? '']));\n      const shares = form.method === 'equal' ? equalSplit(amount, participants)\n        : form.method === 'percentage' ? percentageSplit(amount, splitInput) : customSplit(amount, splitInput);\n      if (!groupIds.includes(form.paidBy)) throw new Error('Select a payer from the group.');\n      onSave({ ...form, description: form.description.trim(), amount, shares, id: initial?.id || crypto.randomUUID(), date: form.date });\n      setError('');\n    } catch (exception) { setError(exception.message || 'Check the expense details and try again.'); }\n  };\n\n  return <form className=\"form-grid\" onSubmit={submit} noValidate>\n    <label className=\"full\">Description<input required maxLength=\"80\" value={form.description} onChange={(event) => set('description', event.target.value)} placeholder=\"e.g. Sunday brunch\" /></label>\n    <label>Amount (₹)<input required min=\"0.01\" step=\"0.01\" type=\"number\" value={form.amount} onChange={(event) => set('amount', event.target.value)} placeholder=\"0.00\" /></label>\n    <label>Date<input required type=\"date\" value={form.date} onChange={(event) => set('date', event.target.value)} /></label>\n    <label>Group<select required value={form.groupId} onChange={(event) => { const nextGroup = groups.find((item) => item.id === event.target.value); setForm((current) => ({ ...current, groupId: event.target.value, paidBy: nextGroup?.members.includes(current.paidBy) ? current.paidBy : nextGroup?.members[0] || '' })); setParticipants(nextGroup?.members || []); setAllocations({}); }}>{groups.map((item) => <option key={item.id} value={item.id}>{item.name}</option>)}</select></label>\n    <label>Category<select value={form.category} onChange={(event) => set('category', event.target.value)}>{categories.map((category) => <option key={category}>{category}</option>)}</select></label>\n    <label className=\"full\">Paid by<select required value={form.paidBy} onChange={(event) => set('paidBy', event.target.value)}>{people.map((person) => <option key={person.id} value={person.id}>{person.name}</option>)}</select></label>\n    <fieldset className=\"split-method full\"><legend>Split method</legend>{['equal', 'percentage', 'custom'].map((method) => <label key={method} className=\"radio\"><input checked={form.method === method} onChange={() => set('method', method)} type=\"radio\" name=\"split-method\" />{method[0].toUpperCase() + method.slice(1)}</label>)}</fieldset>\n    <fieldset className=\"participant-picker full\"><legend>Participants</legend><div className=\"participant-options\">{people.map((person) => <label key={person.id}><input type=\"checkbox\" checked={participants.includes(person.id)} onChange={() => toggleParticipant(person.id)} />{person.name}</label>)}</div></fieldset>\n    {form.method !== 'equal' && <div className=\"allocation full\"><p className=\"field-label\">{form.method === 'percentage' ? 'Shares (must total 100%)' : 'Amounts (must equal the total)'}</p>{people.filter((person) => participants.includes(person.id)).map((person) => <label key={person.id} className=\"allocation-row\"><span>{person.name}</span><input required type=\"number\" min=\"0\" step={form.method === 'percentage' ? '0.01' : '0.01'} value={allocations[person.id] ?? ''} onChange={(event) => setAllocations((current) => ({ ...current, [person.id]: event.target.value }))} placeholder={form.method === 'percentage' ? '%' : '₹'} /></label>)}</div>}\n    {error && <p className=\"form-error full\" role=\"alert\">{error}</p>}\n    <div className=\"modal-actions full\"><button type=\"button\" className=\"button ghost\" onClick={onClose}>Cancel</button><button className=\"button primary\" type=\"submit\">{initial ? 'Save changes' : 'Add expense'}</button></div>\n  </form>;\n}\n"],"file":"/src/components/ExpenseForm.jsx"}